---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { blogClusters, blogPosts } from '../../data/blog';

const groupedPosts = blogClusters.map((cluster) => ({
  ...cluster,
  posts: blogPosts.filter((post) => post.cluster === cluster.key),
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '伊特美甲專欄',
  url: 'https://itungnails.com/blog/',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: blogPosts.length,
    itemListElement: blogPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.title,
      url: new URL(post.href, 'https://itungnails.com').href,
    })),
  },
};
---

<Layout
  title="美甲專欄｜保養知識、款式指南與教學"
  description="伊特美甲專欄依凝膠保養、款式選擇、手足護理與美甲教學分類，整理景美、新店美甲實用知識。"
  schema={schema}
>
  <Header />
  <main class="pt-8 pb-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-it-text mb-4" aria-label="麵包屑">
        <a href="/" class="hover:text-it-cta">首頁</a>
        <span class="mx-2">/</span>
        <span>美甲專欄</span>
      </nav>

      <header class="text-center py-8 md:py-12 max-w-3xl mx-auto">
        <p class="text-it-cta text-sm tracking-widest uppercase mb-3 font-medium">Nail Journal</p>
        <h1 class="text-3xl md:text-4xl font-serif font-bold text-it-dark mb-4">美甲知識與保養專欄</h1>
        <p class="text-it-text leading-relaxed">
          依需求快速找到凝膠保養、款式挑選、手足護理與美甲課程資訊。
        </p>
      </header>

      <nav class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-it-secondary/20 border border-it-secondary/20 mb-16" aria-label="文章主題">
        {groupedPosts.map((cluster) => (
          <a href={`#${cluster.key}`} class="group bg-white p-5 hover:bg-it-light transition-colors">
            <span class="text-xs text-it-cta">{cluster.posts.length} 篇</span>
            <span class="block mt-1 font-bold text-it-dark group-hover:text-it-cta transition-colors">{cluster.title}</span>
            <span class="block mt-2 text-xs leading-relaxed text-it-text">{cluster.description}</span>
          </a>
        ))}
      </nav>

      <div class="space-y-16">
        {groupedPosts.map((cluster) => (
          <section id={cluster.key} class="scroll-mt-24" aria-labelledby={`${cluster.key}-title`}>
            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
              <div>
                <h2 id={`${cluster.key}-title`} class="text-2xl md:text-3xl font-serif font-bold text-it-dark">
                  {cluster.title}
                </h2>
                <p class="mt-2 text-sm text-it-text">{cluster.description}</p>
              </div>
              <a href={cluster.hubHref} class="inline-flex items-center gap-2 text-sm font-bold text-it-cta hover:text-it-dark transition-colors">
                <span>{cluster.hubLabel}</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>

            <div class="border-t border-it-secondary/30">
              {cluster.posts.map((post) => (
                <a href={post.href} class="group grid md:grid-cols-[8rem_1fr_auto] gap-2 md:gap-6 py-6 border-b border-it-secondary/20 items-start">
                  <time datetime={post.date} class="text-xs text-it-cta pt-1">{post.date}</time>
                  <span>
                    <span class="block text-lg font-bold text-it-dark group-hover:text-it-cta transition-colors leading-relaxed">
                      {post.title}
                    </span>
                    <span class="block mt-2 text-sm text-it-text leading-relaxed">{post.excerpt}</span>
                  </span>
                  <svg class="hidden md:block w-5 h-5 mt-1 text-it-secondary group-hover:text-it-cta group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
